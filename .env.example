# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored AND blocked from the assistant by the global secret-file guard.
# Bun auto-loads `.env` into the environment for anything that reads process.env.

# --- Forio authoring credentials ---
# Used by the MVP's archived upload CLI (references/mvp-archive/tools/deploy.ts) and,
# going forward, by the backend model-management component that replaces it.
FORIO_ACCOUNT=ghandourroy
FORIO_PROJECT=model-toolkit-project
FORIO_MODEL_DIR=model

# Auth: your Forio author login. Log in as objectType "admin" via the
# epicenter/manager scope (works for personal AND team accounts) — see mvp-findings §4.
FORIO_HANDLE=YOUR_FORIO_LOGIN
FORIO_PASSWORD="YOUR_FORIO_PASSWORD"

