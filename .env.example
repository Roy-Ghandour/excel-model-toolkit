# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored AND blocked from the assistant by the global secret-file guard.
# Bun auto-loads `.env` into the environment for anything that reads process.env.
# Only secrets live here; the target account/project is in `forio.json`.

# --- Forio admin credentials ---
# A team-account admin (Author or Owner) — the login used for the Epicenter manager UI.
# The Forio driver logs in with project-scoped admin auth, which only team accounts support.
FORIO_HANDLE=YOUR_FORIO_LOGIN
FORIO_PASSWORD="YOUR_FORIO_PASSWORD"
